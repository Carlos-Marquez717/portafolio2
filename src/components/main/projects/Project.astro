---
export interface Props {
  title: string;
  img: string;
  description: string;
  technologies?: { img?: string; title?: string }[];
  link: string;
}

const { technologies = [], title, img, description, link } = Astro.props;
const hasLink = Boolean(link);
---

<li class="li-project reveal">
  <div class="project-image">
    <img src={img} alt={title} loading="lazy" />
  </div>

  <div class="project-body">
    <p class="title-project">{title}</p>
    <p class="description-project">{description}</p>

    <p class="title-technologies">Tecnologías usadas</p>
    <div class="container-technologies">
      {
        technologies.map(({ img, title }) => (
          <div class="technology-item">
            {img && <img src={img} alt={title || "Tecnología"} loading="lazy" />}
            {title && <p>{title}</p>}
          </div>
        ))
      }
    </div>

    <div class="container-link-project">
      {
        hasLink ? (
          <a href={link} target="_blank" rel="noopener noreferrer">Ver más</a>
        ) : (
          <span>Proyecto interno</span>
        )
      }
    </div>
  </div>
</li>

<style>
  .li-project {
    position: relative;
    list-style: none;
    border: 1px solid rgba(255, 255, 255, 0.12);
    overflow: hidden;
    max-width: 390px;
    min-width: 300px;
    width: 100%;
    border-radius: 10px;
    transition: transform 0.35s ease, box-shadow 0.35s ease, border-color 0.35s ease;
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.06), rgba(255, 255, 255, 0.02)),
      #11131c;
    z-index: 1;
    min-height: 100%;
    display: flex;
    flex-direction: column;
    box-shadow: 0 18px 50px rgba(0, 0, 0, 0.24);
  }

  .li-project::before {
    content: "";
    position: absolute;
    width: 100%;
    height: 4px;
    background: linear-gradient(90deg, #01be96, #7b14f1);
    z-index: 2;
    bottom: 0;
    transition: height 0.3s ease-in-out, opacity 0.3s ease-in-out;
    pointer-events: none;
  }

  .li-project:hover::before {
    height: 100%;
    opacity: 0.08;
  }

  .li-project:hover {
    transform: translateY(-10px);
    border-color: rgba(1, 190, 150, 0.38);
    box-shadow: 0 26px 70px rgba(0, 0, 0, 0.36);
  }

  .project-image {
    height: 210px;
    overflow: hidden;
    background: #06070b;
  }

  .project-image img {
    position: relative;
    display: block;
    height: 100%;
    width: 100%;
    object-fit: cover;
    object-position: left top;
    user-select: none;
    pointer-events: none;
    transition: transform 0.45s ease, filter 0.45s ease;
  }

  .li-project:hover .project-image img {
    transform: scale(1.05);
    filter: saturate(1.12) contrast(1.05);
  }

  .project-body {
    display: flex;
    flex: 1;
    flex-direction: column;
  }

  .title-project {
    color: #f6f6f9;
    padding: 18px 16px 10px;
    font-size: 1.35rem;
    font-weight: 800;
    text-align: center;
  }

  .title-technologies {
    font-size: 0.95rem;
    padding: 14px 16px 4px;
    text-align: center;
    color: #01be96;
    font-weight: 700;
  }

  .description-project {
    padding: 0 16px;
    color: rgba(246, 246, 249, 0.7);
    font-size: 0.95rem;
    line-height: 1.55;
    display: -webkit-box;
    -webkit-line-clamp: 11;
    -webkit-box-orient: vertical;
    overflow: hidden;
    white-space: pre-line;
  }

  .container-technologies {
    position: relative;
    display: flex;
    justify-content: center;
    padding: 16px;
    gap: 10px;
    flex-wrap: wrap;
    color: white;
  }

  .technology-item {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
  }

  .container-technologies img {
    height: 42px;
    width: auto;
    max-width: 58px;
    object-fit: contain;
    user-select: none;
    pointer-events: none;
  }

  .container-link-project {
    position: relative;
    width: 100%;
    padding: 0 16px 18px;
    margin-top: auto;
  }

  .container-link-project a,
  .container-link-project span {
    position: relative;
    display: inline-flex;
    text-decoration: none;
    padding: 10px 16px;
    background: rgba(1, 190, 150, 0.1);
    border: 1px solid rgba(1, 190, 150, 0.28);
    border-radius: 999px;
    color: #f6f6f9;
    transition: background 0.25s ease, transform 0.25s ease;
  }

  .container-link-project a:hover {
    background: rgba(1, 190, 150, 0.22);
    transform: translateY(-2px);
  }
</style>
