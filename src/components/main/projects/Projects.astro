---
import { projects } from "../../../const/const";
import Project from "./Project.astro";
---

<section class="section-projects reveal">
  <div class="linear-grandient-1"></div>
  <div class="container-projects">
    <h2 class="title-projects" id="proyectos">PROYECTOS</h2>
    <p class="subtitle-projects">
      Casos donde el foco está en resolver procesos reales: automatización, trazabilidad,
      APIs y sistemas internos listos para operar.
    </p>
    <div>
      <ul class="ul-projects">
        {
          projects.map(({ description, img, link, technologies, title }) => (
            <Project
              img={img}
              description={description}
              link={link}
              title={title}
              technologies={technologies}
            />
          ))
        }
      </ul>
    </div>
  </div>
</section>


<style>
  .linear-grandient-1 {
    position: absolute;
    left: 0;
    top: 1px;
    width: 100%;
    height: 100%;
    background:
      radial-gradient(circle at 80% 10%, rgba(1, 190, 150, 0.16), transparent 28%),
      linear-gradient(to bottom, #06070b, #10121a 45%, #06070b);
    z-index: 0;
  }

  .section-projects {
    position: relative;
    background-color: #06070b;
    overflow: hidden;
  }

  .container-projects {
    position: relative;
    width: 90%;
    margin: 0 auto;
    max-width: 1355px;
  }
  .title-projects {
    position: relative;
    display: block;
    font-size: 27px;
    padding: 54px 0 10px;
    color: #f6f6f9;
    width: 100%;
    font-weight: 800;
    scroll-margin-top: 80px;
    text-align: center;
  }

  .subtitle-projects {
    max-width: 760px;
    margin: 0 auto;
    color: rgba(246, 246, 249, 0.72);
    text-align: center;
    line-height: 1.7;
  }

  .ul-projects {
    position: relative;
    display: grid;
    place-items: center;
    padding: 40px 0;
    width: 100%;
    height: 100%;
  }
  .ul-projects a {
    text-decoration: none;
  }

  /* responsive */

  @media (min-width: 300px) {
    .ul-projects {
      grid-template-columns: 1fr;
      gap: 50px;
    }
  }
  @media (min-width: 700px) {
    .ul-projects {
      grid-template-columns: repeat(2, 1fr);
      gap: 30px;
    }
  }
  @media (min-width: 1200px) {
    .ul-projects {
      grid-template-columns: repeat(3, 1fr);
      justify-content: space-between;
    }
  }
</style>
