---
import { Image } from "astro:assets";
import photoperfil from "../../../../public/img/photo-perfil.png";

const titleLine1 = "BACKEND DEVELOPER".split("");
const titleLine2 = "APIs | AUTOMATION | SYSTEMS".split("");
---

<div class="content-presentation" id="inicio">
  <div class="linear-gradient-2"></div>
  <div class="linear-gradient-1"></div>

  <div class="container-presentation">
    <div class="container-text">
      <h1 class="text-name">CARLOS MARQUEZ</h1>

      <div class="container-profession" aria-label="Título profesional">
        <div class="profession-line">
          {
            titleLine1.map((char) => (
              <span class={`p-profession ${char === " " ? "space" : ""}`}>
                {char === " " ? "\u00A0" : char}
              </span>
            ))
          }
        </div>

        <div class="profession-line">
          {
            titleLine2.map((char) => (
              <span class={`p-profession ${char === " " ? "space" : ""}`}>
                {char === " " ? "\u00A0" : char}
              </span>
            ))
          }
        </div>
      </div>

      <p class="p-presentation">
        Backend Developer especializado en APIs REST y automatización de
        procesos. Stack principal: Python (Django), con experiencia adicional
        en PHP (Laravel) y el ecosistema .NET con C# y ASP.NET Core.
      </p>

      <p class="p-presentation">
        Enfocado en el desarrollo de sistemas empresariales escalables,
        digitalización de procesos, arquitectura backend orientada a rendimiento,
        integración de servicios y optimización de bases de datos.
      </p>

      <div class="container-curriculum">
        <a
          href="https://wa.me/56944691835"
          target="_blank"
          rel="noopener noreferrer"
          class="a-action"
        >
          Hablemos
        </a>

        <a
          href="/img/CARLOSENRIQUEMARQUEZBASTARDO.pdf"
          target="_blank"
          rel="noopener noreferrer"
          class="a-curriculum"
        >
          Ver Currículum
        </a>
      </div>

      <div class="container-social">
        <p class="social-text">Echa un vistazo a mi</p>

        <a
          href="https://github.com/Carlos-Marquez717"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="GitHub de Carlos Marquez"
        >
          <span class="li-social">
            <i class="fa-brands fa-github"></i>
          </span>
        </a>

        <a
          href="https://www.linkedin.com/in/carlosenrique-marquez/"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="LinkedIn de Carlos Marquez"
        >
          <span class="li-social">
            <i class="fa-brands fa-linkedin"></i>
          </span>
        </a>
      </div>
    </div>

    <div class="container-photo-profile">
      <div class="photo-perfil">
        <picture>
          <Image
            src={photoperfil}
            alt="Foto de perfil de Carlos Marquez"
            widths={[300, 400, 500]}
            sizes="(max-width: 900px) 260px, 320px"
          />
        </picture>
      </div>
    </div>
  </div>
</div>

<script>
  const letters = document.querySelectorAll(".p-profession");

  letters.forEach((letter) => {
    if (!letter.classList.contains("space")) {
      letter.addEventListener("mouseenter", () => {
        toggleBounce(letter);
      });
    }
  });

  function toggleBounce(letter) {
    letter.classList.remove("bouncing");
    void letter.offsetWidth;
    letter.classList.add("bouncing");

    letter.addEventListener(
      "animationend",
      () => {
        letter.classList.remove("bouncing");
      },
      { once: true }
    );
  }
</script>

<style>
  .content-presentation {
    position: relative;
    width: 100%;
    min-height: 100vh;
    overflow: hidden;
  }

  .linear-gradient-1 {
    position: absolute;
    inset: 0 auto 0 0;
    width: 520px;
    height: 100%;
    background: radial-gradient(
      circle at left center,
      rgba(106, 4, 223, 0.42),
      transparent 65%
    );
    z-index: 0;
    pointer-events: none;
  }

  .linear-gradient-2 {
    position: absolute;
    inset: 0 0 0 auto;
    width: 100%;
    height: 100%;
    background: radial-gradient(
      circle at right center,
      rgba(106, 4, 223, 0.42),
      #000 55%,
      #000 100%
    );
    z-index: 0;
    pointer-events: none;
  }

  .container-presentation {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 40px;
    width: min(90%, 1355px);
    margin: 0 auto;
    padding: 80px 0;
  }

  .container-text {
    width: 55%;
    color: #f6f6f9;
  }

  .text-name {
    margin: 0 0 18px;
    font-size: clamp(2rem, 4vw, 3rem);
    color: #01be96;
    font-weight: 800;
    letter-spacing: 1px;
    line-height: 1.1;
  }

  .container-profession {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-bottom: 22px;
    cursor: default;
  }

  .profession-line {
    display: flex;
    flex-wrap: wrap;
    row-gap: 4px;
  }

  .p-profession {
    display: inline-block;
    font-size: clamp(2rem, 3.8vw, 3.3rem);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: 2px;
    color: #f6f6f9;
    transition: color 0.25s ease, transform 0.25s ease;
    cursor: pointer;
  }

  .space {
    cursor: default;
  }

  .bouncing {
    color: #01be96;
    animation: rubberband 450ms ease-out;
  }

  @keyframes rubberband {
    0% {
      transform: scale(1);
    }
    35% {
      transform: scaleX(1.15) scaleY(0.8);
    }
    55% {
      transform: scaleX(0.9) scaleY(1.08);
    }
    75% {
      transform: scaleX(1.04) scaleY(0.96);
    }
    100% {
      transform: scale(1);
    }
  }

  .p-presentation {
    margin: 0 0 14px;
    font-size: clamp(1rem, 1.4vw, 1.2rem);
    line-height: 1.7;
    max-width: 720px;
    color: #f0f0f5;
  }

  .container-curriculum {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin-top: 28px;
    margin-bottom: 28px;
  }

  .a-action,
  .a-curriculum {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 180px;
    padding: 14px 28px;
    border: 1px solid #01be96;
    font-size: 1rem;
    font-weight: 600;
    text-decoration: none;
    color: #f6f6f9;
    transition: transform 0.25s ease, background-color 0.25s ease,
      box-shadow 0.25s ease;
  }

  .a-action {
    background-color: rgba(106, 4, 223, 0.45);
  }

  .a-action:hover,
  .a-curriculum:hover {
    transform: translateY(-2px);
    background-color: rgba(106, 4, 223, 0.55);
    box-shadow: 0 8px 24px rgba(106, 4, 223, 0.2);
  }

  .container-social {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 14px;
  }

  .social-text {
    margin: 0;
    font-size: 1rem;
    color: #f6f6f9;
  }

  .container-social a {
    text-decoration: none;
  }

  .li-social {
    list-style: none;
    background-color: rgba(106, 4, 223, 0.55);
    clip-path: polygon(25% 0%, 75% 0%, 100% 50%, 75% 100%, 25% 100%, 0% 50%);
    display: inline-flex;
    justify-content: center;
    align-items: center;
    width: 42px;
    height: 38px;
    transition: transform 0.4s ease, background-color 0.3s ease;
  }

  .li-social i {
    font-size: 1.4rem;
    color: #f6f6f9;
  }

  .li-social:hover {
    transform: rotate(360deg) scale(1.05);
    background-color: rgba(1, 190, 150, 0.3);
  }

  .container-photo-profile {
    width: 45%;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .photo-perfil {
    width: clamp(260px, 28vw, 360px);
    height: clamp(260px, 28vw, 360px);
    border-radius: 50%;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.14);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    border: 1px solid rgba(255, 255, 255, 0.12);
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.35);
  }

  .photo-perfil :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: drop-shadow(-10px -5px 10px #000) contrast(108%);
    transition: transform 0.3s ease;
  }

  .photo-perfil:hover :global(img) {
    transform: scale(1.03);
  }

  @media (max-width: 900px) {
    .container-presentation {
      flex-direction: column-reverse;
      align-items: flex-start;
      gap: 28px;
      padding: 110px 0 70px;
    }

    .container-text,
    .container-photo-profile {
      width: 100%;
    }

    .container-photo-profile {
      justify-content: center;
    }

    .container-profession {
      gap: 10px;
    }

    .p-profession {
      font-size: clamp(1.6rem, 6vw, 2.4rem);
      letter-spacing: 1.5px;
    }

    .p-presentation {
      max-width: 100%;
    }
  }

  @media (max-width: 640px) {
    .container-presentation {
      width: 92%;
      padding-top: 90px;
    }

    .text-name {
      font-size: 2rem;
    }

    .a-action,
    .a-curriculum {
      min-width: 150px;
      padding: 12px 20px;
      font-size: 0.95rem;
    }

    .social-text {
      width: 100%;
    }
  }

  @media (max-width: 500px) {
    .linear-gradient-1 {
      display: none;
    }

    .container-curriculum {
      gap: 12px;
    }

    .a-action,
    .a-curriculum {
      width: 100%;
    }

    .profession-line {
      gap: 0;
    }
  }
</style>
